{
  "buildCommand": "npm run build",
  "outputDirectory": ".output/public",
  "framework": "other",
  "nodeVersion": "20.x",
  "env": {
    "GEMINI_API_KEY": "@gemini_api_key"
  },
  "functions": {
    "api/**": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
