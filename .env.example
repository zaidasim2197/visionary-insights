# VisionPulse Environment Configuration

# Gemini API Key for AI-powered business intelligence
# Get your key from: https://console.cloud.google.com/apis/credentials
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Vercel Environment
# Set automatically by Vercel during deployment
# VERCEL=1
# VERCEL_ENV=production
# VERCEL_URL=your-deployment-url.vercel.app
